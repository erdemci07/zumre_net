rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // ORTAK YARDIMCI FONKSİYONLAR
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasRole(roleName) {
      return isSignedIn()
        && currentUser().data.role == roleName;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isTeacher() {
      return hasRole("teacher");
    }

    function isStudent() {
      return hasRole("student");
    }

    function isStudyGuard() {
      return hasRole("studyGuard");
    }

    function isGuidance() {
      return hasRole("guidance");
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userHasRole(userId, roleName) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.role
          == roleName;
    }

    function isAssignedGuidanceStudent(studentId) {
      return exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.role
          == "student"
        && get(/databases/$(database)/documents/users/$(studentId))
          .data.guidanceCounselorId == request.auth.uid;
    }

    function assignedStudentHasGuardianInfo(studentId) {
      let student = get(
        /databases/$(database)/documents/users/$(studentId)
      ).data;
      return isAssignedGuidanceStudent(studentId)
        && ((student.keys().hasAny(["guardianName"])
            && student.guardianName is string
            && student.guardianName.size() > 0)
          || (student.keys().hasAny(["guardianPhone"])
            && student.guardianPhone is string
            && student.guardianPhone.size() > 0));
    }

    function isValidWeeklyGuidanceSchedule(value) {
      return value is string
        && value in [
          "Her Pazartesi",
          "Her Salı",
          "Her Çarşamba",
          "Her Perşembe",
          "Her Cuma",
          "Her Cumartesi",
          "Her Pazar"
        ];
    }

    function isGuidanceTaskCancelUpdate() {
      return resource.data.active != false
        && request.resource.data.active == false
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["active", "updatedAt"]);
    }

    function isGuidanceTaskScheduleUpdate() {
      return resource.data.active != false
        && request.resource.data.active != false
        && isValidWeeklyGuidanceSchedule(request.resource.data.schedule)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["schedule", "updatedAt"]);
    }

    function isGuidanceAppointmentText(fieldName, maxLength) {
      return request.resource.data[fieldName] is string
        && request.resource.data[fieldName].size() > 0
        && request.resource.data[fieldName].size() <= maxLength;
    }

    function hasValidGuidanceAppointmentCore() {
      return request.resource.data.keys().hasAll([
          "studentId", "studentName", "counselorId", "counselorName",
          "reason", "dayLabel", "time", "status", "createdAt", "updatedAt"
        ])
        && isGuidanceAppointmentText("studentId", 128)
        && isGuidanceAppointmentText("studentName", 120)
        && isGuidanceAppointmentText("counselorId", 128)
        && isGuidanceAppointmentText("counselorName", 120)
        && isGuidanceAppointmentText("reason", 256)
        && isGuidanceAppointmentText("dayLabel", 64)
        && isGuidanceAppointmentText("time", 16)
        && (!request.resource.data.keys().hasAny(["appointmentDate"])
          || (request.resource.data.appointmentDate is string
            && request.resource.data.appointmentDate.size() == 10))
        && request.resource.data.status in [
          "pending", "approved", "in_progress", "completed", "cancelled", "no_show"
        ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(["participantType"])
          || request.resource.data.participantType in ["student", "guardian"])
        && (!request.resource.data.keys().hasAny(["studentViewedAt"])
          || request.resource.data.studentViewedAt is timestamp)
        && (!request.resource.data.keys().hasAny(["recipientInformedAt"])
          || request.resource.data.recipientInformedAt is timestamp)
        && (!request.resource.data.keys().hasAny(["recipientInformedBy"])
          || request.resource.data.recipientInformedBy is string)
        && (!request.resource.data.keys().hasAny(["recipientInformedMethod"])
          || request.resource.data.recipientInformedMethod in [
            "student_verbal", "student_phone", "guardian_verbal", "guardian_phone"
          ])
        && (!request.resource.data.keys().hasAny(["source"])
          || (request.resource.data.source is string
            && request.resource.data.source.size() > 0
            && request.resource.data.source.size() <= 32))
        && (!request.resource.data.keys().hasAny(["approvedAt"])
          || request.resource.data.approvedAt is timestamp)
        && (!request.resource.data.keys().hasAny(["startedAt"])
          || request.resource.data.startedAt is timestamp)
        && (!request.resource.data.keys().hasAny(["completedAt"])
          || request.resource.data.completedAt is timestamp)
        && (!request.resource.data.keys().hasAny(["cancelledAt"])
          || request.resource.data.cancelledAt is timestamp)
        && (!request.resource.data.keys().hasAny(["noShowAt"])
          || request.resource.data.noShowAt is timestamp);
    }

    function hasValidGuidanceAppointmentCreate() {
      return hasValidGuidanceAppointmentCore()
        && request.resource.data.keys().hasOnly([
          "studentId", "studentName", "counselorId", "counselorName",
          "reason", "dayLabel", "appointmentDate", "time", "status", "source", "createdAt",
          "updatedAt", "approvedAt", "startedAt", "completedAt", "cancelledAt", "noShowAt",
          "participantType"
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.status == "pending"
            && !request.resource.data.keys().hasAny([
              "approvedAt", "startedAt", "completedAt", "cancelledAt", "noShowAt"
            ]))
          || (request.resource.data.status == "approved"
            && request.resource.data.keys().hasAll(["approvedAt"])
            && request.resource.data.approvedAt == request.time
            && !request.resource.data.keys().hasAny([
              "startedAt", "completedAt", "cancelledAt", "noShowAt"
            ])));
    }

    function isGuidanceAppointmentStudentViewedUpdate() {
      return request.resource.data.studentViewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["studentViewedAt", "updatedAt"]);
    }

    function isGuidanceAppointmentInformedUpdate() {
      return request.resource.data.recipientInformedAt == request.time
        && request.resource.data.recipientInformedBy == request.auth.uid
        && request.resource.data.recipientInformedMethod in [
          "student_verbal", "student_phone", "guardian_verbal", "guardian_phone"
        ]
        && request.resource.data.status == resource.data.status
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "recipientInformedAt", "recipientInformedBy",
            "recipientInformedMethod", "updatedAt"
          ]);
    }

    function isLegacyGuidancePending() {
      return !resource.data.keys().hasAny(["status"]);
    }

    function isGuidanceStatusTransition(nextStatus) {
      return (isLegacyGuidancePending() && nextStatus == "approved")
        || (resource.data.status == "pending"
          && nextStatus in ["approved", "cancelled", "no_show"])
        || (resource.data.status == "approved"
          && nextStatus in ["in_progress", "cancelled", "no_show"])
        || (resource.data.status == "in_progress" && nextStatus == "completed");
    }

    function hasGuidanceStatusAudit(nextStatus) {
      return request.resource.data.updatedAt == request.time
        && ((nextStatus == "approved"
            && request.resource.data.approvedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "approvedAt"]))
          || (nextStatus == "in_progress"
            && request.resource.data.startedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "startedAt"]))
          || (nextStatus == "completed"
            && request.resource.data.completedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "completedAt"]))
          || (nextStatus == "cancelled"
            && request.resource.data.cancelledAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "cancelledAt"]))
          || (nextStatus == "no_show"
            && request.resource.data.noShowAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status", "updatedAt", "noShowAt"])));
    }

    function runtimeState() {
      return get(
        /databases/$(database)/documents/settings/runtimeState
      ).data;
    }

    function isFreshStudyRuntimeState() {
      return runtimeState().updatedAt is timestamp
        && runtimeState().updatedAt > request.time - duration.value(3, "h");
    }

    function isInstitutionOverrideActive() {
      return runtimeState().institutionMode in ["closed", "exam"];
    }

    function canStartStudySession() {
      return isFreshStudyRuntimeState()
        && runtimeState().isStudyOpen == true
        && !isInstitutionOverrideActive();
    }

    // =========================================================
    // SETTINGS — ZÜMRE / ETÜT / ÖĞLE ARASI SAATLERİ
    // =========================================================

    match /settings/{documentId} {
      // Rehberlikçi öğrenci PII'sini yalnız kendi atandığı öğrenciler için
      // okuyabilir. Diğer personel erişimleri mevcut iş akışları için korunur.
      allow read: if isAdmin()
        || isTeacher()
        || isStudyGuard()
        || isStudent()
        || isGuidance();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // Öğrenci yalnız kendi kaydını ve arayüzde seçim yaptığı
      // öğretmen/rehberlikçi kayıtlarını okuyabilir. Personel mevcut
      // operasyonel akışlar için kullanıcı kayıtlarını okuyabilir.
      allow read: if isSignedIn()
        && (
          isOwner(userId)
          || isAdmin()
          || isTeacher()
          || isStudyGuard()
          || isGuidance()
          || (isStudent() && resource.data.role in ["teacher", "guidance"])
        );
      allow create, update, delete: if isAdmin();

      allow update: if isTeacher()
        && isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "teacherStatus",
            "manualAbsentDate",
            "breakUntil",
            "updatedAt"
          ]);

      allow update: if isStudyGuard()
        && resource.data.role == "student"
        && request.resource.data.role == "student"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "isInStudySession",
            "activeStudySessionId"
          ]);

      allow update: if isStudyGuard()
        && resource.data.role == "teacher"
        && request.resource.data.role == "teacher"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "teacherStatus",
            "breakUntil",
            "updatedAt"
          ]);
    }

    // =========================================================
    // GUIDANCE APPOINTMENTS — REHBERLİK RANDEVULARI
    // =========================================================

    match /guidanceAppointments/{appointmentId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isGuidance() && resource.data.counselorId == request.auth.uid);

      allow create: if hasValidGuidanceAppointmentCreate()
        && ((isStudent()
          && request.resource.data.studentId == request.auth.uid
          && userHasRole(request.resource.data.counselorId, "guidance")
          && currentUser().data.guidanceCounselorId
            == request.resource.data.counselorId
          && request.resource.data.status == "pending"
          && (!request.resource.data.keys().hasAny(["participantType"])
            || request.resource.data.participantType == "student"))
        || (isGuidance()
          && request.resource.data.counselorId == request.auth.uid
          && isAssignedGuidanceStudent(request.resource.data.studentId)
          && (!request.resource.data.keys().hasAny(["participantType"])
            || request.resource.data.participantType == "student"
            || (request.resource.data.participantType == "guardian"
              && assignedStudentHasGuardianInfo(
                request.resource.data.studentId
              )))
          && request.resource.data.status == "approved"));

      allow update: if isStudent()
        && resource.data.studentId == request.auth.uid
        && hasValidGuidanceAppointmentCore()
        && (isGuidanceAppointmentStudentViewedUpdate()
          || (request.resource.data.status == "cancelled"
            && (isLegacyGuidancePending()
              || resource.data.status in ["pending", "approved"])
            && hasGuidanceStatusAudit("cancelled")));

      allow update: if isGuidance()
        && resource.data.counselorId == request.auth.uid
        && hasValidGuidanceAppointmentCore()
        && isAssignedGuidanceStudent(resource.data.studentId)
        && (isGuidanceAppointmentInformedUpdate()
          || (isGuidanceStatusTransition(request.resource.data.status)
            && hasGuidanceStatusAudit(request.resource.data.status)));

      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // GUIDANCE TASKS — HAFTALIK REHBERLİK TAKİPLERİ
    // =========================================================
    match /guidanceTasks/{taskId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isGuidance() && resource.data.counselorId == request.auth.uid);
      allow update: if isGuidance()
        && resource.data.counselorId == request.auth.uid
        && request.resource.data.counselorId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && isAssignedGuidanceStudent(resource.data.studentId)
        && (isGuidanceTaskCancelUpdate()
          || isGuidanceTaskScheduleUpdate());
      allow delete: if isGuidance()
        && resource.data.counselorId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // APPOINTMENTS — PLANLI ZÜMRE RANDEVULARI
    // =========================================================

    match /appointments/{appointmentId} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isTeacher()
          && resource.data.transferredFromTeacherId == request.auth.uid
          && resource.data.status == "scheduled"
          && resource.data.transferEditUntil is timestamp
          && resource.data.transferEditUntil > request.time);

      // Critical lifecycle writes are server-authoritative via callable
      // Cloud Functions. The Admin SDK bypasses rules for those writes.
      allow create, update, delete: if false;
    }

    match /appointmentLocks/{lockId} {
      allow read, write: if false;
    }

    // =========================================================
    // QUEUES — ZÜMRE SIRALARI
    // =========================================================

    match /queues/{queueId} {

      allow read: if isSignedIn();

      // Queue oluşturma/iptal lifecycle'ı callable Cloud Functions üzerinden
      // server-authoritative yürür. Admin SDK bu kuralları bypass eder.
      allow create: if isAdmin();

      allow update: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == "in_progress"
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.extraMinutes >= resource.data.extraMinutes
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "extraMinutes",
            "updatedAt"
          ]);

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // =========================================================
    // STUDY SESSIONS — ETÜT OTURUMLARI
    // =========================================================

    match /studySessions/{sessionId} {

      allow read: if isSignedIn();

      allow create: if isStudyGuard()
        && request.resource.data.staffId == request.auth.uid
        && request.resource.data.status == "active"
        && canStartStudySession();

      allow update: if isStudyGuard()
        && resource.data.staffId == request.auth.uid
        && request.resource.data.staffId == resource.data.staffId;

      allow create, update, delete: if isAdmin();

      match /students/{studentId} {

        allow read: if isSignedIn();

        allow create, update: if isStudyGuard()
          && get(
            /databases/$(database)/documents/studySessions/$(sessionId)
          ).data.staffId == request.auth.uid;

        allow create, update, delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
